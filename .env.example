# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Prisma ORM connection string (Neon Postgres in this project).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# PORT: HTTP port the admin server listens on (defaults to 3000).
PORT=3000

# NODE_ENV: "production" enables Secure cookies + HSTS, "development" keeps Vite middleware.
NODE_ENV="development"
