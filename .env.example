# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Prisma ORM connection string (Neon Postgres in this project).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# PORT: HTTP port the admin server listens on (defaults to 3000).
PORT=3000

# NODE_ENV: "production" enables Secure cookies + HSTS, "development" keeps Vite middleware.
NODE_ENV="development"

# CORS: comma-separated list of allowed origins for cross-domain access. If empty, no cross-site CORS is applied.
ALLOWED_ORIGINS="https://admin.example.com,https://store.example.com"

# ADMIN_API_KEYS: comma-separated list of bearer API keys allowed for server-to-server or cross-domain API calls.
# Example: ADMIN_API_KEYS="key1,key2"
ADMIN_API_KEYS=""

# If true, session cookie SameSite will be set to None (and Secure must be enabled by running NODE_ENV=production or setting SECURE_COOKIES=true)
ALLOW_CROSS_SITE_COOKIES="false"

